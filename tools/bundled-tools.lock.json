      "upstream": {
        "type": "html-regex",
        "url": "https://www.libreoffice.org/release-notes/",
        "pattern": "LibreOffice\\s+([0-9]+\\.[0-9]+\\.[0-9]+)\\s*\\([^)]*\\)\\s*-\\s*Previous Branch",
