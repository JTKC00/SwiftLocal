{
  "schemaVersion": 1,
  "lastReviewed": "2026-09-16",
  "policy": {
    "mode": "notify-only",
    "description": "reviewedVersion is the last upstream version reviewed by SwiftLocal maintainers. It is not automatically the version bundled in a release unless bundledVersionSource is present.",
    "scope": "Windows x64 release tools. macOS native Homebrew/application copies remain unpinned and are outside the current release scope; see tools/README.md and docs/WINDOWS_ACCEPTANCE_2026-09-16.md."
  },
  "tools": {
    "ytDlp": {
      "name": "yt-dlp",
      "reviewedVersion": "2026.08.19",
      "bundledVersionSource": {
        "type": "json",
        "path": "tools/media-download-tools.lock.json",
        "property": "ytDlp.version"
      },
      "upstream": {
        "type": "github-release",
        "repository": "yt-dlp/yt-dlp"
      }
    },
    "deno": {
